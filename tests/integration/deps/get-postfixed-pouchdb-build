#!/bin/bash -eux

log() {
  echo "[get-postfixed-pouchdb-build] $*"
}

fetch() {
  local version="$1"
  local remoteFile="$2"
  local target="$3"

  local nodots="$(tr -d . <<<"$version")"

  local tmp="$(mktemp)"

  log "Fetching minified pouch build $target..."
  wget "https://github.com/pouchdb/pouchdb/releases/download/$version/$remoteFile" --output-document="$tmp"

  log "Converting globals..."
  sed "s/PouchDB/PouchDBVersion$nodots/g" "$tmp" > "$target"
}

# Recently, postfixed JS files have been added in minified form.
infix=".min"
while [[ $# -gt 1 ]]; do
  if [[ $1 = --no-minify ]]; then
    infix=""
  else
    echo "!!! Unrecognised arg: $1"
    exit 1
  fi
  shift
done

version="$1"

fetch "$version" "pouchdb-${version}${infix}.js" "./pouchdb-$version-postfixed.js"
if [[ "${version%%.*}" -ge 6 ]]; then
  fetch "$version" "pouchdb.indexeddb.js" "./pouchdb-$version.indexeddb-postfixed.js"
fi

log "Completed OK."
