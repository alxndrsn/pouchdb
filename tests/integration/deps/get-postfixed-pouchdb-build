#!/bin/bash -eux

log() {
  echo "[get-postfixed-pouchdb-build] $*"
}

# Recently, postfixed JS files have been added in minified form.
infix=".min"
while [[ $# -gt 1 ]]; do
  if [[ $1 = --no-minify ]]; then
    infix=""
  else
    echo "!!! Unrecognised arg: $1"
    exit 1
  fi
  shift
done

version="$1"
echo "Checking major version: ${version%%.*}"
if [[ "${version%%.*}" -ge 6 ]]; then
  remoteFile="pouchdb.indexeddb${infix}.js"
else
  remoteFile="pouchdb-${version}${infix}.js"
fi

target="./pouchdb-$version-postfixed.js"
nodots="$(tr -d . <<<"$version")"
tmp="$(mktemp)"

log "Fetching minified pouch build..."
wget "https://github.com/pouchdb/pouchdb/releases/download/$version/$remoteFile" --output-document="$tmp"

log "Converting globals..."
sed "s/PouchDB/PouchDBVersion$nodots/g" "$tmp" > "$target"

log "Completed OK."
